<template id="captions-template">
  <div id="captions" data-composition-id="captions" data-start="0" data-duration="42.800" data-width="1080" data-height="1920">
    <style>
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('../assets/fonts/BeVietnamPro-800.ttf') format('truetype');
        font-style: normal;
        font-weight: 800;
      }
      #captions {
        position: relative;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: transparent;
        pointer-events: none;
      }
      #captions .caption-stage {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 300px;
        padding: 0 64px;
        text-align: center;
      }
      #captions .caption-group {
        position: absolute;
        left: 64px;
        right: 64px;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        opacity: 0;
        visibility: hidden;
        will-change: transform, opacity;
      }
      #captions .caption-label,
      #captions .caption-text {
        display: inline-block;
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.012em;
        paint-order: stroke fill;
        text-shadow: 0 3px 8px rgba(0, 0, 0, 0.50);
      }
      #captions .caption-label {
        font-size: 72px;
        line-height: 1;
        -webkit-text-stroke: 7px #0a0a0a;
      }
      #captions .caption-label:empty {
        display: none;
      }
      #captions .caption-text {
        max-width: 920px;
        font-size: 54px;
        line-height: 1.12;
        -webkit-text-stroke: 6px #0a0a0a;
      }
    </style>

    <div class="caption-stage" id="caption-stage"></div>

    <script>
      window.__timelines = window.__timelines || {};

      const CAPTION_GROUPS = [
        { text: "Người luôn luôn hạ thấp bạn", start: 0.20, end: 2.40, label: "#1" }
      ];

      const stage = document.getElementById('caption-stage');
      CAPTION_GROUPS.forEach((group, index) => {
        const wrap = document.createElement('div');
        wrap.id = `cg-${index}`;
        wrap.className = 'caption-group';

        const label = document.createElement('span');
        label.className = 'caption-label';
        label.textContent = group.label || '';

        const text = document.createElement('span');
        text.className = 'caption-text';
        text.textContent = group.text;

        wrap.append(label, text);
        stage.appendChild(wrap);
      });

      const tl = gsap.timeline({ paused: true });
      CAPTION_GROUPS.forEach((group, index) => {
        const selector = `#cg-${index}`;
        tl.set(selector, { opacity: 0, visibility: 'visible', y: 10, scale: 0.94 }, Math.max(0, group.start - 0.001));
        tl.to(selector, { opacity: 1, y: 0, scale: 1, duration: 0.14, ease: 'power2.out' }, group.start);
        tl.set(selector, { opacity: 0, visibility: 'hidden' }, group.end);
      });
      window.__timelines.captions = tl;
    </script>
  </div>
</template>
