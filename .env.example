# ============================================================
# mkt-automation — mẫu biến môi trường
# Sao chép file này thành .env rồi chỉ điền các biến cần dùng:
#   cp .env.example .env
# Không điền secret thật vào file .env.example.
# ============================================================

# HeyGen — upload audio, tạo avatar video và lip-sync
HEYGEN_API_KEY=
HEYGEN_AVATAR_LOOKS=
HEYGEN_VOICE_ID=
HEYGEN_MAX_SECONDS=

# ElevenLabs — text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# MiniMax — nhà cung cấp TTS thay thế
TTS_PROVIDER=elevenlabs
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_API_BASE=https://api.minimax.io

# Nghiên cứu, media và xuất bản
YOUTUBE_API_KEY=
PEXELS_API_KEY=
APIFY_TOKEN=
BLOTATO_API_KEY=

# Tuỳ chọn — tạo hình, phiên âm và tài sản thương hiệu
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOMMO_ACCESS_TOKEN=
GOMMO_DOMAIN=79ai.net
MKT_BRAND_AVATAR=

# BIZ.MKT.OS có mẫu env riêng tại:
# huong dan/MKT.LANDINGPAGE.SKILLS-main/.env.example
